# ============================================================================
#  Template environment file — copy this to `.env` and fill in your values.
# ============================================================================
#      cd backend
#      cp .env.example .env      # then edit .env
#
#  `.env` is git-ignored, so it never travels with the repository. This template
#  is what a teammate (or the hosting platform) uses to reproduce the setup.
#
#  On Render these are set as environment variables in the dashboard instead —
#  see render.yaml and DEPLOY.md.
# ============================================================================

# --- Server ---------------------------------------------------------------
# Port the Express API listens on. The frontend expects 3000 locally.
# Render sets this automatically; do not hardcode it there.
PORT=3000

# --- Database -------------------------------------------------------------
# Local development: the MariaDB instance installed on this machine.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=restaurant_system
DB_CONNECTION_LIMIT=5

# Set to true when the database requires an encrypted connection.
# Aiven (and most managed MySQL providers) require this. Local MariaDB does not.
# DB_SSL=true

# Only needed when the database is reachable by Unix socket rather than TCP
# (for example MariaDB under Termux on Android). Takes priority over
# DB_HOST/DB_PORT when set.
# DB_SOCKET_PATH=/data/data/com.termux/files/usr/var/run/mysqld.sock

# --- Auth -----------------------------------------------------------------
# Signing key for login JWTs. Generate your own; do not reuse the example.
# The server refuses to start without it — there is no fallback on purpose,
# because a default secret would make every token forgeable.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-your-own-random-32-byte-hex-string

# --- CORS -----------------------------------------------------------------
# Comma-separated list of origins allowed to call the API from ANOTHER host.
# Leave empty for local development, and in production too: the Express server
# serves the frontend itself, so requests are same-origin and CORS is not used.
# ALLOWED_ORIGINS=https://your-frontend.example.com
